        <script><![CDATA[const actConf = new GlideRecord('x_1297629_confer_0_conferences');

// Query for active conferences
actConf.addQuery('end_date', '>', new GlideDateTime());  // Check end date relative to current day
actConf.query();

// Loop through each active conference record
if (actConf.next()) {
    // Check if the end_date is in the past
    const endDate = new GlideDateTime(actConf.end_date);
    const currentDate = new GlideDateTime();

    // If the conference's end date has not passed, activate it
    if (endDate > currentDate) {
        actConf.active = true; // Set 'active' field to true

        actConf.update();
    }
}
]]></script>
