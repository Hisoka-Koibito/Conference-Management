        <template><![CDATA[<div class="form-container">
  <h1>Create New Conference</h1>
  <form class="form" ng-submit="submitForm()">
    <label>Name of Conference:</label>
    <input type="text" class="form-control" ng-model="name">
    <br>

    <label>Location:</label>
    <select class="form-control" ng-model="location">
      <option value="">Select Location</option>
      <!-- Add your location options here -->
    </select>
    <br>

    <label>Start Date:</label>
    <input type="date" class="form-control" ng-model="start_date">
    <br>
    
    <label>End Date:</label>
    <input type="date" class="form-control" ng-model="end_date">
    <br>

<label>Manager:</label>
<select class="form-control" ng-model="manager" ng-options="manager.id as manager.name for manager in managers">
  <option value="">None</option> <!-- Default option -->
</select>
<br>


    <label>Subject:</label>
    <select class="form-control" ng-model="subject">
      <option value="">None</option>
      <option value="Biotech">Biotech</option>
      <option value="Criminal Justice">Criminal Justice</option>
      <option value="Engineering">Engineering</option>
      <option value="Health and Wellness">Health and Wellness</option>
      <option value="History">History</option>
      <option value="Home Economics">Home Economics</option>
      <option value="Mathematics">Mathematics</option>
      <option value="Political Science">Political Science</option>
      <option value="Science">Science</option>
      <option value="Technology">Technology</option>
      <option value="Theology">Theology</option>
      <option value="Trolling">Trolling</option>
    </select>
    <br>

    <!-- Validation Error Message -->
    <div ng-show="errorMessage" class="error-message" style="color: red;">
      {{ errorMessage }}
    </div>

    <div class="buttons">
      <button class="btn btn-primary" type="submit" ng-hide="submitting">
        Submit
      </button>
      <button class="btn btn-primary" type="submit" ng-show="submitting" disabled>
        Submitting...
      </button>
    </div>
  </form>
</div>
]]></template>
