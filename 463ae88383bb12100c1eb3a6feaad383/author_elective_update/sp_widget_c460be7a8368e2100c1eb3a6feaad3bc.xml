        <script><![CDATA[(function() {
    // Define the Sys IDs of the roles you want to filter by
    var roleSysIds = [
        'ce3ae88383bb12100c1eb3a6feaad38a',  // Role 1 Sys ID
        'ce3ae88383bb12100c1eb3a6feaad390'   // Role 2 Sys ID
    ];

    // Create a GlideRecord to fetch users with the desired roles
    var userGr = new GlideRecord('sys_user');
    userGr.addQuery('roles.sys_id', 'IN', roleSysIds); // Filter by Sys IDs of roles
    userGr.query();

    var managers = [];
    while (userGr.next()) {
        managers.push({
            name: userGr.name, // Name of the user
            id: userGr.sys_id.toString() // Sys ID for use in the select value
        });
    }

    // Return the managers list to the client-side script
    data.managers = managers;

    // Check if input exists (form submission)
    if (input) {
        if (input.action === "create_record") {
            createRecord(input);
        }
    }

    // Function to create the conference record
    function createRecord(input) {
        var gr = new GlideRecord("x_1297629_confer_0_conferences");
        gr.initialize();
        gr.setValue('name', input.name);
        gr.setValue('location', input.location);
        gr.setValue('manager', input.manager);  // manager Sys ID
        gr.setValue('start_date', input.start_date);
        gr.setValue('end_date', input.end_date);
        gr.setValue('subject', input.subject);
        gr.setValue('description', input.description);
        gr.insert();
    }
})(input, data);
]]></script>
