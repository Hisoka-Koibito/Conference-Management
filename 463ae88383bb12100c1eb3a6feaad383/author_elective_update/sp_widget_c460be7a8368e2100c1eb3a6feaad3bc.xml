        <category>custom</category>
        <client_script><![CDATA[api.controller = function($scope) {
  var c = this;

  $scope.submitting = false;

  // This will be called when the form is submitted
  $scope.submitForm = function() {
    $scope.submitting = true;

    // Set the data to be sent to the server
    c.data.action = "create_record";
    c.data.name = $scope.name;
    c.data.location = $scope.location;
    c.data.manager = $scope.manager;  // Sys ID of the selected manager
    c.data.start_date = $scope.start_date;
    c.data.end_date = $scope.end_date;
    c.data.subject = $scope.subject;
    c.data.description = $scope.description;

    c.server.update().then(function() {
      // After server call success, you can handle the response if necessary
      $scope.submitting = false;  // Reset the submitting state
    });
  };

  // On load, populate the managers from the server-side response
  c.server.get().then(function(response) {
    $scope.managers = response.data.managers;
  });
	console.log(response.data.managers);
};
]]></client_script>
